<table class="table generaltable">
  <thead>
    <tr>
      <th>{{#str}} name, tiny_styles {{/str}}</th>
      <th>{{#str}} description, tiny_styles {{/str}}</th>
      <th>{{#str}} presentation, tiny_styles {{/str}}</th>
      <th>{{#str}} actions, tiny_styles {{/str}}</th>
    </tr>
  </thead>
  <p>
    <a href="{{createcaturl}}" class="btn btn-primary">
      {{createcategory}}
    </a>
  </p>
  <tbody>
  {{#categories}}
    <tr>
      <td>{{name}}</td>
      <td>{{description}}</td>
      <td>{{presentation}}</td>
      <td>
            {{{toggleiconhtml}}}

        <a href="{{elementsurl}}" class="mr-2" title="{{#str}} elements, tiny_styles {{/str}}" style="text-decoration: none;">
          <i class="fa-solid fa-list"></i>
        </a>

            {{{moveupiconhtml}}}
            {{{movedowniconhtml}}}

        <a href="{{editurl}}" class="mr-2" title="{{#str}} editcategory, tiny_styles {{/str}}" style="text-decoration: none;">
          <i class="icon fa fa-cog fa-fw"></i>
        </a>

            {{{deleteiconhtml}}}
      </td>
    </tr>
  {{/categories}}
  {{^categories}}
    <tr>
      <td colspan="4">{{#str}} nocategories, tiny_styles {{/str}}</td>
    </tr>
  {{/categories}}
  </tbody>
</table>
