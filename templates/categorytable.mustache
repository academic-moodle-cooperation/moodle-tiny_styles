<table class="table generaltable">
  <thead>
    <tr>
      <th>{{#str}} name, tiny_styles {{/str}}</th>
      <th>{{#str}} description, tiny_styles {{/str}}</th>
      <th>{{#str}} presentation, tiny_styles {{/str}}</th>
      <th>{{#str}} actions, tiny_styles {{/str}}</th>
    </tr>
  </thead>
  <p>
    <a href="{{createcaturl}}" class="btn btn-primary">
      {{createcategory}}
    </a>
  </p>
  <tbody>
  {{#categories}}
    <tr>
      <td>{{name}}</td>
      <td>{{description}}</td>
      <td>{{presentation}}</td>
      <td>
        {{! Eye icon  }}
        <a href="{{viewurl}}" class="mr-2" title="{{#str}} view, tiny_styles {{/str}}">
          <i class="icon fa fa-eye fa-fw"></i>
        </a>
        {{! View elements }}
        <a href="{{elementsurl}}" class="mr-2" title="{{#str}} elements, tiny_styles {{/str}}">
          <i class="fa-solid fa-list"></i>
        </a>
        {{! Move up }}
        <a href="{{moveupurl}}" class="mr-2" title="{{#str}} moveup, tiny_styles {{/str}}">
          <i class="icon fa fa-arrow-up fa-fw"></i>
        </a>
        {{! Move down }}
        <a href="{{movedownurl}}" class="mr-2" title="{{#str}} movedown, tiny_styles {{/str}}">
          <i class="icon fa fa-arrow-down fa-fw"></i>
        </a>
        {{! Edit }}
        <a href="{{editurl}}" class="mr-2" title="{{#str}} editcategory, tiny_styles {{/str}}">
          <i class="icon fa fa-cog fa-fw"></i>
        </a>
        {{! Delete }}
        <a href="{{deleteurl}}" class="mr-2" title="{{#str}} deletecategory, tiny_styles {{/str}}">
          <i class="icon fa fa-trash fa-fw"></i>
        </a>
      </td>
    </tr>
  {{/categories}}
  {{^categories}}
    <tr>
      <td colspan="4">{{#str}} nocategories, tiny_styles {{/str}}</td>
    </tr>
  {{/categories}}
  </tbody>
</table>
